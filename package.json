{
  "name": "tabdesk",
  "version": "0.1.13",
  "description": "Terminal workspace for Claude Code projects: a tab rail of terminals on the left, the active project on the right.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icons": "./build/render-icons.sh",
    "dist": "electron-builder --linux deb tar.gz",
    "postinstall": "electron-rebuild -f -w node-pty",
    "test": "electron test/main.js"
  },
  "author": {
    "name": "Jonaz Thern",
    "email": "info@thern.io"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "node-pty": "^1.0.0",
    "ssh2": "^1.17.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "build": {
    "appId": "io.thern.tabdesk",
    "productName": "TabDesk",
    "files": [
      "main.js",
      "preload.js",
      "picker-preload.js",
      "portable-preload.js",
      "portable.js",
      "settings-preload.js",
      "sync/**",
      "update-preload.js",
      "updater.js",
      "preview-preload.js",
      "preview-runner.js",
      "term-embed.js",
      "theme.js",
      "tray.js",
      "i18n.js",
      "settings.js",
      "model.js",
      "agents.js",
      "app-runner.js",
      "usage-worker.js",
      "usage-limits.js",
      "renderer/**",
      "themes/**",
      "i18n/**",
      "build/icon.png",
      "build/tray.png",
      "build/tray@2x.png",
      "node_modules/**"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "linux": {
      "target": [
        "deb",
        "tar.gz"
      ],
      "category": "Development;TerminalEmulator",
      "icon": "build/icons",
      "synopsis": "Terminal workspace for Claude Code projects",
      "desktop": {
        "entry": {
          "Name": "TabDesk",
          "Comment": "Terminal workspace for Claude Code projects",
          "Keywords": "terminal;claude;projects;development;",
          "StartupWMClass": "TabDesk"
        }
      },
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libdbusmenu-glib4",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0",
        "xterm",
        "xdotool",
        "python3-gi"
      ]
    }
  },
  "homepage": "https://github.com/TheJonaz/tabdesk",
  "desktopName": "tabdesk.desktop"
}
